{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-android-intelligence.dev/schemas/gateway/v2/dispatched-schema-fixtures-1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "catalogEntries", "bindingSets"],
  "properties": {
    "formatVersion": { "const": "1.0.0" },
    "catalogEntries": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/catalogEntry" }
    },
    "bindingSets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/bindingSet" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "eventKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "eventType", "schemaSha256"],
      "properties": {
        "kind": { "const": "event" },
        "eventType": { "$ref": "#/$defs/nonEmptyString" },
        "schemaSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "deviceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pluginId",
        "authorKeyId",
        "capabilityId",
        "capabilityVersion",
        "schemaSha256"
      ],
      "properties": {
        "kind": { "const": "device.request" },
        "pluginId": { "$ref": "#/$defs/nonEmptyString" },
        "authorKeyId": { "$ref": "#/$defs/nonEmptyString" },
        "capabilityId": { "$ref": "#/$defs/nonEmptyString" },
        "capabilityVersion": { "$ref": "#/$defs/nonEmptyString" },
        "schemaSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "successKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation", "status", "schemaSha256"],
      "properties": {
        "kind": { "const": "response.success" },
        "operation": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "type": "integer" },
        "schemaSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "failureKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "errorCode", "schemaSha256"],
      "properties": {
        "kind": { "const": "response.failure" },
        "errorCode": { "$ref": "#/$defs/nonEmptyString" },
        "schemaSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "catalogKey": {
      "oneOf": [
        { "$ref": "#/$defs/eventKey" },
        { "$ref": "#/$defs/deviceKey" },
        { "$ref": "#/$defs/successKey" },
        { "$ref": "#/$defs/failureKey" }
      ]
    },
    "eventLogicalKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "eventType"],
      "properties": {
        "kind": { "const": "event" },
        "eventType": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "deviceLogicalKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pluginId",
        "authorKeyId",
        "capabilityId",
        "capabilityVersion"
      ],
      "properties": {
        "kind": { "const": "device.request" },
        "pluginId": { "$ref": "#/$defs/nonEmptyString" },
        "authorKeyId": { "$ref": "#/$defs/nonEmptyString" },
        "capabilityId": { "$ref": "#/$defs/nonEmptyString" },
        "capabilityVersion": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "successLogicalKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation", "status"],
      "properties": {
        "kind": { "const": "response.success" },
        "operation": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "type": "integer" }
      }
    },
    "failureLogicalKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "errorCode"],
      "properties": {
        "kind": { "const": "response.failure" },
        "errorCode": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "logicalKey": {
      "oneOf": [
        { "$ref": "#/$defs/eventLogicalKey" },
        { "$ref": "#/$defs/deviceLogicalKey" },
        { "$ref": "#/$defs/successLogicalKey" },
        { "$ref": "#/$defs/failureLogicalKey" }
      ]
    },
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "key", "schema"],
      "properties": {
        "fixtureId": { "$ref": "#/$defs/nonEmptyString" },
        "key": { "$ref": "#/$defs/catalogKey" },
        "schema": { "type": "object" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "schemaSha256"],
      "properties": {
        "key": { "$ref": "#/$defs/logicalKey" },
        "schemaSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bindingSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bindings"],
      "properties": {
        "id": { "const": "gateway-core-fixtures-v1" },
        "bindings": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/binding" }
        }
      }
    }
  }
}
