{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-android-intelligence.dev/schemas/gateway/v2/command-catalog.schema.json",
  "$defs": {
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "catalogVersion", "languageCode", "commands"],
      "properties": {
        "format": { "const": "agent-command-catalog-1.0" },
        "catalogVersion": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "languageCode": { "type": "string", "minLength": 1 },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "invocation", "title", "description", "acceptsArguments", "availability"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "invocation": {
                "type": "string",
                "pattern": "^/[a-z0-9_-]+$"
              },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "acceptsArguments": { "type": "boolean" },
              "availability": { "type": "string", "minLength": 1 },
              "argumentHint": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
