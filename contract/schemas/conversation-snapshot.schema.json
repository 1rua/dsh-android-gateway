{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-android-intelligence.dev/schemas/gateway/v2/conversation-snapshot.schema.json",
  "$defs": {
    "mirrorSync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotRevision", "conversations"],
      "properties": {
        "snapshotRevision": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/positiveInt"
        },
        "conversations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["conversationId", "revision", "updatedAt"],
            "properties": {
              "conversationId": {
                "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
              },
              "title": { "type": "string" },
              "revision": {
                "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/positiveInt"
              },
              "updatedAt": {
                "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/utcMillis"
              },
              "tombstoned": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
