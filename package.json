{
  "name": "dsh-android-gateway",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Open Android Intelligence Core 0.2 Native Session Adapter for DeepSeek Harness",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "src/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/",
    "tools/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node -e \"console.log('No compilation needed for native ESM adapter')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:upstream": "node tools/verify-upstream-drift.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
